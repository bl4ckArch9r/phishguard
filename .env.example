# Copy to .env (never commit it). All values are optional.

# Protect the API: if set, requests must send  X-API-Key: <value>
PHISHGUARD_API_KEY=

# Scans allowed per IP per minute
PHISHGUARD_RATE_PER_MIN=20

# Threat-intelligence providers. A provider without a key is shown as
# "not configured" and adds nothing to the score.
VIRUSTOTAL_API_KEY=
GOOGLE_SAFE_BROWSING_KEY=
URLHAUS_AUTH_KEY=

# Where scan history is stored
# PHISHGUARD_DB=/data/phishguard.db

# !!! TESTING ONLY. Lets the page fetcher reach 127.0.0.1 / private ranges.
# !!! Never set this on a server that is reachable by other people.
# PHISHGUARD_ALLOW_PRIVATE=1
